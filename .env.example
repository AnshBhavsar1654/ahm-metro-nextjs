# Copy to .env (git-ignored) and fill in what you have. Everything is optional.

# Google AI Studio key for the chatbot's agent. Without it the chatbot still answers fares, routes,
# greetings and nearest-station questions from the app's own data; everything else returns 503.
GEMINI_API_KEY=

# Upstash Redis (REST). Keeps the visit count, who is online, per-IP limits, the chat answer cache and
# model cooldowns shared across server instances and deploys. Without it they live in the server process
# (the visit total is saved to .data/visits.json). Vercel's KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenWeatherMap key for the home page weather (sent to the browser). Without it the weather is hidden.
NEXT_PUBLIC_WEATHER_API_KEY=
NEXT_PUBLIC_WEATHER_CITY=Ahmedabad,IN
